# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Vercel: add this as a project Environment Variable, not to the frontend.

# OPEN_METEO_BASE_URL: Base URL for Open-Meteo weather API
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API Key for Routes, Maps JavaScript, and Geocoding
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# IMD official warnings (optional). {district} is replaced by IMD district id/name.
# If unset, the app shows "IMD unavailable" and never fabricates warnings.
IMD_WARNINGS_URL="https://mausam.imd.gov.in/api/warnings_district_api.php?id={district}"
# Optional JSON map of lowercase district name -> IMD district obj_id.
# Nagercoil is covered by Kanyakumari district (verified official Obj_id: 30).
# Add/override districts as you verify them from the official IMD district list:
# IMD_DISTRICT_MAP='{"nagercoil":"30","kanyakumari":"30","chennai":"<imd-chennai-obj-id>"}'
IMD_DISTRICT_MAP="{}"
# Optional IMD marine/fisherman advisory text endpoint
IMD_MARINE_URL=""
IMD_API_KEY=""
GEMINI_MODEL=""
